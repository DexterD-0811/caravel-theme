<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <h2 class="mb-8 text-center font-serif text-2xl md:text-3xl">
      {{ section.settings.heading }}
    </h2>

    {% assign b = blogs[section.settings.blog] %}
    {% if b != blank and b.articles_count > 0 %}
      <div class="grid gap-6 md:grid-cols-3">
        {% for article in b.articles limit: section.settings.limit %}
          <a href="{{ article.url }}" class="block overflow-hidden rounded-2xl ring-1 ring-black/10 hover:ring-black/20">
            <div class="relative aspect-[16/9] w-full bg-black/5">
              {% if article.image != blank %}
                <img
                  src="{{ article.image | image_url: width: 1400 }}"
                  alt="{{ article.title | escape }}"
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                  width="1400"
                  height="788">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-black/15' }}
              {% endif %}
            </div>

            <div class="p-4">
              <p class="font-serif text-lg">{{ article.title }}</p>
              <p class="mt-1 text-xs text-black/60">{{ article.published_at | date: "%b %d, %Y" }}</p>
              {% if article.excerpt != blank %}
                <p class="mt-2 text-sm text-black/70">{{ article.excerpt | strip_html | truncate: 90 }}</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="text-center text-sm text-black/60">
        Pick a blog in the Theme Editor to show posts here.
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Blog preview",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest From Our Blog" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Posts to show", "min": 1, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Blog preview" }]
}
{% endschema %}
