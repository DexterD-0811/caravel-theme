<footer class="relative isolate z-50 bg-[#8B6F5A] text-white">
  <div class="mx-auto max-w-7xl px-4 py-14">
    <!-- Footer Grid -->
    <div class="grid gap-10 md:grid-cols-4">

      <!-- Column 1: Brand -->
      <div>
        <img
          src="{{ 'caravel_logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="h-7 w-auto"
          loading="lazy">

        <p class="mt-4 text-sm text-white/80">
          Modern essentials in warm neutrals. Designed for everyday wear.
        </p>

        <p class="mt-4 text-xs text-white/60">
          © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <p class="mb-3 text-sm font-semibold">Quick Links</p>
        <ul class="space-y-2 text-sm text-white/80">
          <li><a href="{{ routes.root_url }}" class="hover:text-white underline-offset-4 hover:underline">Home</a></li>
          <li><a href="{{ routes.collections_url }}" class="hover:text-white underline-offset-4 hover:underline">Shop</a></li>
          <li><a href="/pages/about" class="hover:text-white underline-offset-4 hover:underline">About</a></li>
          <li><a href="/blogs/news" class="hover:text-white underline-offset-4 hover:underline">Blog</a></li>
          <li><a href="/pages/contact" class="hover:text-white underline-offset-4 hover:underline">Contact</a></li>
        </ul>
      </div>

      <!-- Column 3: Customer Service -->
      <div>
        <p class="mb-3 text-sm font-semibold">Customer Service</p>
        <ul class="space-y-2 text-sm text-white/80">
          <li><a href="/policies/shipping-policy" class="hover:text-white underline-offset-4 hover:underline">Shipping</a></li>
          <li><a href="/policies/refund-policy" class="hover:text-white underline-offset-4 hover:underline">Returns</a></li>
          <li><a href="/policies/privacy-policy" class="hover:text-white underline-offset-4 hover:underline">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service" class="hover:text-white underline-offset-4 hover:underline">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div>
        <p class="mb-3 text-sm font-semibold">Newsletter</p>
        <p class="mb-4 text-sm text-white/80">
          Join our list for early access and exclusive offers.
        </p>

        {% form 'customer', class: "flex gap-2" %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <input
            type="email"
            name="contact[email]"
            required
            placeholder="Email address"
            class="h-10 w-full rounded-md border border-white/30 bg-white/10 px-3 text-sm text-white placeholder:text-white/60 outline-none focus:border-white/60">

          <button
            type="submit"
            class="h-10 shrink-0 rounded-md bg-white px-4 text-sm font-semibold text-[#8B6F5A] hover:opacity-90">
            Join
          </button>
        {% endform %}
      </div>

    </div>
  </div>

  {% schema %}
  {
    "name": "Footer",
    "settings": []
  }
  {% endschema %}
</footer>
