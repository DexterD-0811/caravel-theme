<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-10 md:py-14">
    <div class="grid gap-6 md:grid-cols-2">

      <!-- Left promo -->
      <div class="overflow-hidden rounded-2xl ring-1 ring-black/10 bg-caravel-sand">
        <div class="relative aspect-[16/7] w-full bg-black/5">
          {% if section.settings.left_image != blank %}
            <img
              src="{{ section.settings.left_image | image_url: width: 1600 }}"
              alt="{{ section.settings.left_image.alt | escape }}"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              width="1600"
              height="700">
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-black/15' }}
          {% endif %}
          <div class="absolute inset-0 bg-black/10"></div>
        </div>

        <div class="p-6 text-center">
          <p class="font-serif text-2xl leading-tight">{{ section.settings.left_heading }}</p>
          {% if section.settings.left_button_label != blank and section.settings.left_button_link != blank %}
            <a href="{{ section.settings.left_button_link }}"
               class="mt-4 inline-flex rounded-md bg-caravel-brown px-6 py-2 text-sm font-semibold text-white hover:opacity-95">
              {{ section.settings.left_button_label }}
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Right signup -->
      <div class="overflow-hidden rounded-2xl ring-1 ring-black/10 bg-caravel-sand">
        <div class="relative aspect-[16/7] w-full bg-black/5">
          {% if section.settings.right_image != blank %}
            <img
              src="{{ section.settings.right_image | image_url: width: 1600 }}"
              alt="{{ section.settings.right_image.alt | escape }}"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              width="1600"
              height="700">
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-black/15' }}
          {% endif %}
          <div class="absolute inset-0 bg-black/10"></div>
        </div>

        <div class="p-6 text-center">
          <p class="font-serif text-2xl leading-tight">{{ section.settings.right_heading }}</p>
          <p class="mt-2 text-sm text-black/70">{{ section.settings.right_subheading }}</p>

          {% form 'customer', class: "mt-4 flex items-center justify-center gap-2" %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input
              type="email"
              name="contact[email]"
              required
              placeholder="Email address"
              class="h-10 w-full max-w-xs rounded-md border border-black/15 bg-white px-3 text-sm outline-none focus:border-black/40">
            <button type="submit"
              class="h-10 rounded-md bg-caravel-brown px-5 text-sm font-semibold text-white hover:opacity-95">
              Subscribe
            </button>
          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo + Signup",
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Left promo image" },
    { "type": "text", "id": "left_heading", "label": "Left heading", "default": "Up to 40% Off\nSpring Sale" },
    { "type": "text", "id": "left_button_label", "label": "Left button label", "default": "Shop Now" },
    { "type": "url", "id": "left_button_link", "label": "Left button link" },

    { "type": "image_picker", "id": "right_image", "label": "Right signup image" },
    { "type": "text", "id": "right_heading", "label": "Right heading", "default": "Sign Up & Save 10%" },
    { "type": "text", "id": "right_subheading", "label": "Right subheading", "default": "Join our newsletter for 10% off your first order" }
  ],
  "presets": [{ "name": "Promo + Signup" }]
}
{% endschema %}
