{% comment %}
  Caravel — Collections index (/collections)
{% endcomment %}

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <header class="mb-10 text-center">
      <h1 class="font-serif text-3xl tracking-tight md:text-4xl">
        {{ section.settings.heading }}
      </h1>
      {% if section.settings.subheading != blank %}
        <p class="mt-2 text-sm text-black/60">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </header>

    {% if collections.size > 0 %}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for c in collections %}
          {% if section.settings.show_all_collection or c.handle != 'all' %}
            <a href="{{ c.url }}" class="group overflow-hidden rounded-3xl ring-1 ring-black/10 hover:ring-black/20">
              <div class="relative aspect-[4/3] bg-black/5">
                {% if c.featured_image != blank %}
                  <img
                    src="{{ c.featured_image | image_url: width: 1400 }}"
                    alt="{{ c.title | escape }}"
                    class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                    loading="lazy"
                    width="1400"
                    height="1050">
                {% else %}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-black/15' }}
                {% endif %}
              </div>

              <div class="bg-white px-5 py-4 text-center">
                <p class="font-serif text-lg">{{ c.title }}</p>
                <p class="mt-1 text-sm text-black/60">{{ c.products_count }} products</p>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="rounded-3xl bg-black/5 p-10 text-center ring-1 ring-black/10">
        <p class="font-semibold">No collections yet</p>
        <p class="mt-2 text-sm text-black/70">Create collections in Shopify Admin to show them here.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Browse by category" },
    { "type": "checkbox", "id": "show_all_collection", "label": "Show the 'All' collection", "default": false }
  ],
  "presets": [{ "name": "Collections list" }]
}
{% endschema %}
