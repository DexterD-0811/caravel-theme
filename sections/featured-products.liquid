<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <h2 class="mb-8 text-center font-serif text-2xl md:text-3xl">
      {{ section.settings.heading }}
    </h2>

    {% assign c = section.settings.collection %}
    {% if c == blank %}
      {% assign c = collections['all'] %}
    {% endif %}

    {% if c != blank and c.products_count > 0 %}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {% for product in c.products limit: section.settings.limit %}
          {% render 'product-card', product: product, show_badge: section.settings.show_badge %}
        {% endfor %}
      </div>
    {% else %}
      <p class="text-center text-sm text-black/60">
        No products yet. Choose a collection in the Theme Editor (or add products).
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_badge", "label": "Show Best Seller badge", "default": true }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
