{% assign p = product %}
{% assign v = p.selected_or_first_available_variant %}

<article class="overflow-hidden rounded-2xl bg-white ring-1 ring-black/10">
  <a href="{{ p.url }}" class="block">
    <div class="relative aspect-[3/4] w-full bg-black/5">
      {% if p.featured_image != blank %}
        <img
          src="{{ p.featured_image | image_url: width: 900 }}"
          alt="{{ p.featured_image.alt | escape }}"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          width="900"
          height="1200">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-black/15' }}
      {% endif %}

      {% if show_badge %}
        <div class="absolute left-3 top-3 rounded bg-[#8B6F5A] px-2 py-1 text-[11px] font-semibold text-white">
          Best Seller
        </div>
      {% endif %}
    </div>

    <div class="px-4 pb-3 pt-3 text-center">
      <p class="font-serif text-base">{{ p.title }}</p>
      <p class="mt-1 text-sm text-black/70">
        {{ v.price | money }}
        {% if v.compare_at_price > v.price %}
          <span class="ml-2 text-xs text-black/50 line-through">{{ v.compare_at_price | money }}</span>
        {% endif %}
      </p>
    </div>
  </a>

  <div class="px-4 pb-4">
    {% if v.available %}
      <button
        type="button"
        class="js-add-to-cart w-full rounded-xl bg-[#8B6F5A] px-4 py-2 text-center text-sm font-semibold text-white hover:opacity-95 disabled:opacity-50"
        data-variant-id="{{ v.id }}"
        data-original-text="Add to cart">
        Add to cart
      </button>
    {% else %}
      <div class="w-full rounded-xl border border-black/15 px-4 py-2 text-center text-sm text-black/60">
        Sold out
      </div>
    {% endif %}
  </div>
</article>
